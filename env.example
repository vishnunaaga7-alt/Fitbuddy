# Gemini API key. Get one from Google AI Studio.
GEMINI_API_KEY=

# Current model defaults can be overridden without changing code.
GEMINI_WORKOUT_MODEL=gemini-3.1-pro-preview
GEMINI_TIP_MODEL=gemini-3.8-flash

# SQLite database file.
DATABASE_URL=sqlite:///./data/fitbuddy.db

# Admin credentials for /view-all-users and delete actions.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Application settings.
APP_NAME=FitBuddy
DEBUG=true
